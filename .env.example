# Screenbox environment configuration
# Quick setup: ./setup.sh (generates token + builds images automatically)
# Manual: cp .env.example .env && set SCREENBOX_API_TOKEN

# --- Required ---

# API token for dashboard (REQUIRED -- won't start without it)
# Generate: openssl rand -hex 32
SCREENBOX_API_TOKEN=

# --- Optional ---

# Desktop container image
# SCREENBOX_DESKTOP_IMAGE=screenbox:latest

# Host paths for persistent data (defaults: ./data/*)
# SCREENBOX_HOST_DATA=./data/desktops
# SCREENBOX_HOST_LOGS=./data/logs
# SCREENBOX_HOST_KNOWLEDGE=./data/knowledge
# SCREENBOX_HOST_RECORDINGS=./data/recordings

# Absolute host path for recordings (set by setup.sh, needed for Docker bind mounts)
# SCREENBOX_RECORDINGS_HOST_DIR=/absolute/path/to/data/recordings

# --- Traefik reverse proxy (see docker-compose.prod.yml) ---
# SCREENBOX_DOMAIN=screenbox.example.com
# SCREENBOX_TRAEFIK_ENTRYPOINT=websecure

# --- Snapshots ---
# SCREENBOX_AUTO_SNAPSHOT_MINUTES=30
# SCREENBOX_ENCRYPT_SNAPSHOTS=true

# --- Vision model (OpenAI-compatible API) ---
# SCREENBOX_VISION_MODEL=google/gemini-2.0-flash-001

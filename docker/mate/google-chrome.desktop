[Desktop Entry]
Version=1.0
Name=Chromium
Comment=Access the Internet
Exec=/usr/bin/chromium --no-first-run --disable-sync --disable-default-apps --disable-gpu %U
StartupNotify=true
Terminal=false
Icon=chromium
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
